cabal-version: 3.0
name: nvim-config-hs
version: 0.1.0.0
build-type: Simple

library
  exposed-modules:
    InputSource
    KeyboardLayout
    Session
  hs-source-dirs: src
  build-depends:
    base >=4.18 && <5,
    filepath >=1.4 && <2
  default-language: GHC2021
  ghc-options: -Wall -Wcompat

executable nvim-config-hs
  main-is: Main.hs
  hs-source-dirs: app
  other-modules: PluginRegistry
  build-depends:
    base >=4.18 && <5,
    nvim-config-hs,
    nvim-hs >=2.3 && <2.4
  default-language: GHC2021
  ghc-options: -Wall -threaded

test-suite pure-tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  build-depends:
    base >=4.18 && <5,
    nvim-config-hs
  default-language: GHC2021
  ghc-options: -Wall
